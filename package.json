{
  "name": "bun-react-native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "bun tools/bun-bundler/cli.ts start",
    "start:metro": "expo start",
    "android": "expo run:android --no-bundler",
    "ios": "expo run:ios --no-bundler",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:tools": "bun test",
    "reset-project": "node ./scripts/reset-project.js",
    "eas-build-pre-install": "chmod +x tools/bin/node && set-env PATH \"$EAS_BUILD_WORKINGDIR/tools/bin:$PATH\"",
    "eas-build-post-install": "node -e \"if (!process.versions.bun) { console.error('node is not Bun: tools/bin/node is not first on PATH'); process.exit(1) }\""
  },
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./tests/setup/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/docs/",
      "/tools/"
    ]
  }
}
