{
  "name": "bun-react-native",
  "version": "0.1.0",
  "description": "Run the whole Expo / React Native toolchain on Bun: Metro on the Bun runtime (byte-identical to Node), an optional Bun bundler, a node -> Bun shim, Jest on Bun",
  "license": "MIT",
  "author": "Bartlomiej Zimny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jash90/bun-react-native.git"
  },
  "homepage": "https://github.com/jash90/bun-react-native#readme",
  "keywords": [
    "bun",
    "react-native",
    "expo",
    "metro",
    "bundler"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "bin": {
    "bun-react-native": "tools/cli/index.ts",
    "node": "tools/bin/node"
  },
  "files": [
    "app.plugin.js",
    "preload.js",
    "plugins/",
    "tools/",
    "!tools/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "expo": ">=57.0.0 <59.0.0"
  },
  "workspaces": [
    "example"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --cwd example typecheck",
    "typecheck:tools": "bun check -p tools",
    "lint": "bun run --cwd example lint",
    "test:example": "bun run --cwd example test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
